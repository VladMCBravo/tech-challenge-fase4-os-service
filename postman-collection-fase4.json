{
  "info": {
    "name": "FIAP SOAT - Tech Challenge Fase 4 (Microsserviços + Saga Pattern + Mercado Pago)",
    "description": "Collection completa cobrindo os 3 microsserviços (OS Service, Billing Service e Execution Service), fluxo feliz da Saga Coreografada e cenários de Rollback/Compensação.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "os_url", "value": "http://localhost:3000/api" },
    { "key": "billing_url", "value": "http://localhost:3001/api" },
    { "key": "execution_url", "value": "http://localhost:3002/api" },
    { "key": "jwt_token", "value": "" },
    { "key": "work_order_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. OS Service (PostgreSQL - :3000)",
      "item": [
        {
          "name": "1.1 Abrir Ordem de Serviço",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{os_url}}/work-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"cust-01\",\n  \"vehicleId\": \"veh-01\",\n  \"initialNotes\": \"Revisão completa e freios\"\n}"
            }
          }
        },
        {
          "name": "1.2 Iniciar Diagnóstico",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{os_url}}/work-orders/{{work_order_id}}/diagnosis/start"
          }
        },
        {
          "name": "1.3 Solicitar Aprovação (Reserva Estoque + Dispara Saga os.budget.requested)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{os_url}}/work-orders/{{work_order_id}}/awaiting-approval"
          }
        },
        {
          "name": "1.4 Compensação / Rollback Manual da OS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{os_url}}/work-orders/{{work_order_id}}/compensate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Falha simulada na transação distribuída\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Billing Service + Mercado Pago (PostgreSQL - :3001)",
      "item": [
        {
          "name": "2.1 Consultar Orçamento e Cobrança Mercado Pago da OS",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{billing_url}}/budgets/work-order/{{work_order_id}}"
          }
        },
        {
          "name": "2.2 Webhook Mercado Pago - Pagamento Aprovado (Dispara payment.approved)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{billing_url}}/budgets/webhook/mercadopago",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderId\": \"{{work_order_id}}\",\n  \"mercadoPagoId\": \"mp_approved_12345\",\n  \"status\": \"approved\"\n}"
            }
          }
        },
        {
          "name": "2.3 Webhook Mercado Pago - Pagamento Recusado (Dispara Rollback payment.failed)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{billing_url}}/budgets/webhook/mercadopago",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderId\": \"{{work_order_id}}\",\n  \"status\": \"rejected\",\n  \"reason\": \"Cartão recusado pelo emissor\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Execution Service (MongoDB NoSQL - :3002)",
      "item": [
        {
          "name": "3.1 Consultar Fila Priorizada de Execução (NoSQL)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{execution_url}}/executions/queue"
          }
        },
        {
          "name": "3.2 Atualizar Progresso do Mecânico",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{execution_url}}/executions/work-order/{{work_order_id}}/progress",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stage\": \"IN_REPAIR\",\n  \"mechanicName\": \"Carlos Mecânico\",\n  \"notes\": \"Substituição de peças em andamento\"\n}"
            }
          }
        },
        {
          "name": "3.3 Finalizar Execução (Dispara Saga execution.finished)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{execution_url}}/executions/work-order/{{work_order_id}}/finish",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mechanicName\": \"Carlos Mecânico\",\n  \"notes\": \"Reparo concluído e testado\"\n}"
            }
          }
        },
        {
          "name": "3.4 Falha Crítica na Execução (Dispara Rollback execution.failed -> Estorna Pagamento e Estoque)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{execution_url}}/executions/work-order/{{work_order_id}}/fail",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mechanicName\": \"Carlos Mecânico\",\n  \"reason\": \"Trinca estrutural irreparável identificada na execução\"\n}"
            }
          }
        }
      ]
    }
  ]
}
